generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorldwideStatus {
  ACCEPTED
  REJECTED
}

model Job {
  id                 String   @id @default(uuid())
  sourceName         String
  sourceType         String
  title              String
  company            String
  location           String?
  remote             Boolean  @default(true)
  seniority          String?
  applyUrl           String
  finalUrl           String?
  descriptionText    String
  descriptionSnippet String?
  worldwideStatus    WorldwideStatus
  worldwideEvidence  Json?
  rejectionReason    String?
  matchedRejectPatterns Json?
  matchedKeywords    Json?
  urlStatus          String?
  httpStatus         Int?
  contentHash        String?
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @default(now())
  alertedSlackAt     DateTime?
  alertedEmailAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  alertLogs          AlertLog[]

  @@unique([title, company])
  @@index([worldwideStatus])
  @@index([sourceName])
  @@index([company])
}

model Source {
  id          String   @id @default(uuid())
  name        String   @unique
  type        String
  baseUrl     String?
  enabled     Boolean  @default(true)
  lastRunAt   DateTime?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IngestionRun {
  id           String   @id @default(uuid())
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  status       String
  jobsFound    Int      @default(0)
  jobsAccepted Int      @default(0)
  jobsRejected Int      @default(0)
  errorLog     String?
}

model AlertLog {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  type      String
  status    String
  error     String?
  sentAt    DateTime @default(now())
}
